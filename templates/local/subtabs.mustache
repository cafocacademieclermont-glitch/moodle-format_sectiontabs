{{!
    @template format_grettabs/local/subtabs

    Tabs of the subsections of a section: only the subsection of the selected tab is displayed.

    Example context (json):
    {
        "uniqid": "gsubtabs1",
        "style": "--gtabs-active:#ecb21e;",
        "subtabs": [
            {"cmid": 10, "num": 12, "name": "Classe virtuelle", "title": "Classe virtuelle", "active": true},
            {"cmid": 11, "num": 13, "name": "S'informer", "title": "S'informer", "hidden": true},
            {"cmid": 12, "num": 14, "name": "Dire", "title": "Dire", "unavailable": true}
        ],
        "editing": true
    }
}}
<nav id="{{uniqid}}" class="gsubtabs" style="{{style}}" aria-label="{{#str}} subtabsnav, format_grettabs {{/str}}">
    <ul class="gsubtabs-list">
        {{#subtabs}}
        <li class="gsubtabs-item">
            <a class="gsubtabs-tab{{#active}} gsubtabs-active{{/active}}{{#hidden}} gtabs-hidden{{/hidden}}{{#unavailable}} gsubtabs-unavailable{{/unavailable}}"
               href="#section-{{num}}" title="{{title}}" data-gsubtab="{{cmid}}" data-num="{{num}}"
               {{#active}}aria-current="true"{{/active}}>{{{name}}}</a>
        </li>
        {{/subtabs}}
        {{#editing}}
        <li class="gsubtabs-item gsubtabs-item-all">
            <a class="gsubtabs-tab gsubtabs-all" href="#" data-gsubtab="all">{{#str}} subtabsshowall, format_grettabs {{/str}}</a>
        </li>
        {{/editing}}
    </ul>
</nav>
{{#js}}
(function() {
    var nav = document.getElementById('{{uniqid}}');
    if (!nav) {
        return;
    }
    var tabs = Array.prototype.slice.call(nav.querySelectorAll('[data-gsubtab]'));
    // The hidden subsections are hidden by a style rule rather than a class on the
    // elements, so that they stay hidden when the course editor re-renders them.
    var rules = document.createElement('style');
    document.head.appendChild(rules);
    var show = function(tab) {
        var hidden = [];
        tabs.forEach(function(other) {
            var on = (other === tab);
            other.classList.toggle('gsubtabs-active', on);
            if (on) {
                other.setAttribute('aria-current', 'true');
            } else {
                other.removeAttribute('aria-current');
            }
            if (!on && tab.dataset.gsubtab !== 'all' && other.dataset.gsubtab !== 'all') {
                hidden.push('#region-main li[data-for="cmitem"][data-id="' + other.dataset.gsubtab + '"]');
            }
        });
        rules.textContent = hidden.length ? hidden.join(',') + '{display:none !important;}' : '';
    };
    var fromHash = function() {
        var match = /^#section-(\d+)$/.exec(window.location.hash);
        var found = match ? tabs.filter(function(t) {
            return t.dataset.num === match[1];
        })[0] : null;
        return found || nav.querySelector('.gsubtabs-active') || tabs[0];
    };
    tabs.forEach(function(tab) {
        tab.addEventListener('click', function(e) {
            e.preventDefault();
            show(tab);
            if (window.history && window.history.replaceState) {
                var hash = tab.dataset.num ? '#section-' + tab.dataset.num : '';
                window.history.replaceState(null, '', window.location.pathname + window.location.search + hash);
            }
        });
    });
    window.addEventListener('hashchange', function() {
        show(fromHash());
    });
    show(fromHash());
})();
{{/js}}
