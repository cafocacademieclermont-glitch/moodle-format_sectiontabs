{{!
    @template format_grettabs/local/tabs

    Tab bar listing the course sections.

    Example context (json):
    {
        "style": "--gtabs-active:#ecb21e;--gtabs-active-border:#2b1a10;",
        "tabs": [
            {"name": "Accueil", "title": "Accueil", "url": "#", "active": true},
            {"name": "Bloc 1", "title": "Bloc 1 : Actes essentiels", "url": "#", "hidden": true},
            {"name": "Bloc 2", "title": "Bloc 2", "url": "#", "unavailable": true}
        ]
    }
}}
<nav class="gtabs" style="{{style}}" aria-label="{{#str}} tabsnav, format_grettabs {{/str}}">
    <ul class="gtabs-list">
        {{#tabs}}
        <li class="gtabs-item">
            {{#unavailable}}
            <span class="gtabs-tab gtabs-unavailable{{#active}} gtabs-active{{/active}}" title="{{title}}"{{#active}} aria-current="page"{{/active}}>{{{name}}}</span>
            {{/unavailable}}
            {{^unavailable}}
            <a class="gtabs-tab{{#active}} gtabs-active{{/active}}{{#hidden}} gtabs-hidden{{/hidden}}" href="{{url}}" title="{{title}}"{{#active}} aria-current="page"{{/active}}{{#external}} target="_blank" rel="noopener"{{/external}}>{{{name}}}</a>
            {{/unavailable}}
        </li>
        {{/tabs}}
    </ul>
</nav>
